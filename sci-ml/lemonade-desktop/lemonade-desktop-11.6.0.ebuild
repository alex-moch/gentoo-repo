DESCRIPTION="Native desktop client for Lemonade Server (Tauri/WebKitGTK)"
HOMEPAGE="https://lemonade-server.ai/ https://github.com/lemonade-sdk/lemonade"
SRC_URI="
	https://github.com/lemonade-sdk/lemonade/archive/refs/tags/v${PV}.tar.gz -> lemonade-server-${PV}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/lemonade-${PV}"

# Apache-2.0 for the app itself; the rest is the union of every vendored
# crate's own license field (scanned directly from each .crate's Cargo.toml
# after fetching, not guessed) — matches how e.g. app-antivirus/clamav and
# app-backup/rdedup list their bundled/vendored dependency licenses.
LICENSE="0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD BSD-2 Boost-1.0
	CC0-1.0 ISC LGPL-2.1+ MIT MIT-0 MPL-2.0 Unicode-3.0 Unlicense ZLIB"
SLOT="0"
KEYWORDS="~amd64"

# network-sandbox: `npm ci` fetches the renderer's react/webpack toolchain
# (~432 packages) from the npm registry; Gentoo has no equivalent of
# cargo.eclass for vendoring npm offline (see sci-ml/lemonade-server).
# Cargo itself stays fully offline/vendored regardless of this restrict --
# cargo.eclass's generated config.toml hardcodes [net] offline = true.
RESTRICT="test network-sandbox"

COMMON_DEPEND="
	dev-libs/glib
	net-libs/libsoup:3.0
	net-libs/webkit-gtk:4.1
	x11-libs/cairo
	x11-libs/gdk-pixbuf
	x11-libs/gtk+:3
"
DEPEND="${COMMON_DEPEND}"
RDEPEND="
	${COMMON_DEPEND}
	sci-ml/lemonade-server
"
BDEPEND="
	net-libs/nodejs[npm]
	virtual/pkgconfig
"

src_configure() {
	cargo_src_configure
}

src_compile() {
	cd "${S}/src/app" || die
	npm ci --ignore-scripts || die "npm ci failed"
	cargo_env npm run build:nobundle || die "tauri build failed"
}

src_install() {
	dobin "${S}/src/app/src-tauri/target/release/lemonade-app"
	domenu "${S}/data/lemonade-app.desktop"
	newicon -s scalable "${S}/src/app/assets/logo.svg" lemonade-app.svg
}

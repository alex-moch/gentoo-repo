ACCEPT_KEYWORDS="~amd64"
ACCEPT_LICENSE="*"
USE_EXPAND="VMWARE_GUESTS"

# Provide a portable x86-64-v3 baseline as the default, so systems without a
# machine-specific make.conf (containers, generic VMs) still get a sane set and
# packages such as dev-util/claude-code that require avx/avx2 are satisfied.
# Arrowlake machines override this with their fuller set in make.conf.
CPU_FLAGS_X86="avx avx2 bmi1 bmi2 f16c fma3 mmx mmxext popcnt sse sse2 sse3 sse4_1 sse4_2 ssse3"

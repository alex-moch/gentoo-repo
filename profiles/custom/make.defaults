ACCEPT_KEYWORDS="~amd64"
ACCEPT_LICENSE="*"
USE_EXPAND="VMWARE_GUESTS"
USE="threads"

# Provide a portable x86-64-v3 baseline as the default, so systems without a
# machine-specific make.conf (containers, generic VMs) still get a sane set and
# packages such as dev-util/claude-code that require avx/avx2 are satisfied.
# aes and rdrand are added on top even though they aren't part of the v3 level:
# both are old, widely-supported flags that packages checking for them gate
# behind a runtime CPUID check, so there's no penalty on hardware that lacks
# them.
CPU_FLAGS_X86="aes avx avx2 bmi1 bmi2 f16c fma3 mmx mmxext popcnt rdrand sse sse2 sse3 sse4_1 sse4_2 ssse3"

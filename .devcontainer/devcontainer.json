{
	// VS Code Dev Container for the ajm overlay, on the gentoo-agent base image.
	// Targets Podman; set "dev.containers.dockerPath": "podman" in VS Code.
	"name": "gentoo-agent",
	"image": "localhost/gentoo-agent:20260713",
	// The live overlay is bind-mounted over the base's synced ::ajm and is also
	// the editor workspace, so edits and pkgdev manifest land on the host.
	"workspaceFolder": "/var/db/repos/ajm",
	"workspaceMount": "source=${localWorkspaceFolder},target=/var/db/repos/ajm,type=bind",
	// Non-root so Claude Code's bypassPermissions mode is allowed to run;
	// passwordless sudo in the image covers root-only actions.
	"remoteUser": "user",
	// Map the host's invoking UID/GID onto the image's fixed user:1000/1000 via
	// podman's user namespace, so bind-mounted files stay host-owned without
	// baking a host-specific UID into the image or needing VS Code's
	// rebuild-and-patch-/etc/passwd derived image.
	"updateRemoteUserUID": false,
	"runArgs": ["--userns=keep-id:uid=1000,gid=1000"],
	"mounts": [
		"source=gentoo-binpkgs,target=/var/cache/binpkgs,type=volume",
		"source=gentoo-distfiles,target=/var/cache/distfiles,type=volume"
	],
	"remoteEnv": { "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}" },
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code"
			]
		}
	}
}

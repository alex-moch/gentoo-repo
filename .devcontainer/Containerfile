# Builds the gentoo-agent base image (used by devcontainer.json) from the
# imported stage3b-agent stage. The stage already carries the custom/agent
# profile and the agent toolset in @system, so nothing is emerged here; this
# only syncs the ebuild trees and enables binary packages.
#
# Import the stage, then build:
#   podman import stage3b-agent-amd64-latest.tar.bz2 localhost/gentoo-stage3b-agent:20260713
#   podman build -t localhost/gentoo-agent:20260713 -f .devcontainer/Containerfile .devcontainer
FROM localhost/gentoo-stage3b-agent:20260713

# Install binary packages from the binhost, reusing one only on a USE match. This
# needs a binhost in binrepos.conf and its key trusted in /etc/portage/gnupg.
RUN echo 'FEATURES="getbinpkg"' >> /etc/portage/make.conf

# Sync the ebuild trees from git; the stage carries the repo config but not the
# trees. The live overlay is bind-mounted over /var/db/repos/ajm at runtime, so
# this synced copy only needs to resolve the profile.
RUN rm -rf /var/db/repos/* /etc/portage/repos.conf/* \
 && eselect repository add gentoo git https://github.com/gentoo-mirror/gentoo \
 && eselect repository add ajm git https://gitlab.com/alex-moch/gentoo-repo.git \
 && emerge --sync \
 && getuto
